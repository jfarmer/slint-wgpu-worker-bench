# The Linux software-driver image plus SwiftShader, so the Vulkan loader sees two ICDs:
# Mesa lavapipe and SwiftShader. Build docker/Dockerfile as slint-wgpu-worker-bench-linux first;
# scripts/docker-two-icd.sh does both. The build is limited to 4 jobs,
# since compiling its bundled LLVM with more exhausts an 8 GB Docker VM.
FROM ubuntu:24.04 AS swiftshader

ARG SWIFTSHADER_COMMIT=1e80438d2b93ef36a7c05f8d2b81233bac0e3d16
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git cmake ninja-build build-essential python3 libx11-dev libxext-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://swiftshader.googlesource.com/SwiftShader /src/swiftshader \
    && git -C /src/swiftshader checkout "$SWIFTSHADER_COMMIT"
RUN cmake -S /src/swiftshader -B /src/build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DSWIFTSHADER_BUILD_TESTS=OFF -DSWIFTSHADER_BUILD_BENCHMARKS=OFF -DSWIFTSHADER_WARNINGS_AS_ERRORS=OFF \
    && cmake --build /src/build --target vk_swiftshader --parallel 4 \
    && mkdir -p /opt/swiftshader \
    && cp "$(find /src/build -name libvk_swiftshader.so | head -1)" /opt/swiftshader/ \
    && printf '{"file_format_version":"1.0.0","ICD":{"library_path":"/opt/swiftshader/libvk_swiftshader.so","api_version":"1.3.0"}}\n' \
        > /opt/swiftshader/vk_swiftshader_icd.json

FROM slint-wgpu-worker-bench-linux
COPY --from=swiftshader /opt/swiftshader /opt/swiftshader
